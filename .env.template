# OpenHeart Configuration — .env template
# Copy to .env and fill in your values.
# cp .env.template .env

# Required: DeepSeek API key for cloud inference fallback
DEEPSEEK_API_KEY=your_api_key_here

# Runtime mode: mock | live
OPENHEART_MODE=mock

# VRAM tier: auto | high | medium | low
# auto = detect at startup
OPENHEART_VRAM_TIER=auto
